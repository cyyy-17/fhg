# Forest Hills Garden (FHG) - Environment Configuration

# ------------------------------------------------------------------------------
# 1. Admin Authentication (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Password used to log into the Admin CMS at /admin/login.
# Set a strong, unique password in Vercel Environment Variables.
ADMIN_PASSWORD=your_custom_admin_password_here

# Secret key used to sign and verify HMAC-SHA256 admin session cookies.
# Generate a random 32+ character string in production.
SESSION_SECRET=your_random_32_char_secret_key_here

# ------------------------------------------------------------------------------
# 2. Cloud Data Persistence (Vercel KV / Upstash Redis)
# ------------------------------------------------------------------------------
# In serverless environments, Vercel KV persists CMS records across builds.
# Both variables are automatically provided when linking a Vercel KV store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ------------------------------------------------------------------------------
# 3. Email Notification for RFP / Inquiries (Resend)
# ------------------------------------------------------------------------------
# Optional Resend API key for emailing new customer inquiries to operations.
# All submissions are ALWAYS recorded in the Admin Inbox (/admin/inquiries)
# regardless of whether an email service is configured.
# Test dispatch is available directly from Settings -> Routing.
RESEND_API_KEY=
CONTACT_EMAIL=edluna1971@yahoo.com

# ------------------------------------------------------------------------------
# 4. Public Site & Canonical URL
# ------------------------------------------------------------------------------
# Canonical domain used for OpenGraph cards, sitemaps, JSON-LD, and robots.txt.
# Default if unset: https://fhg-two.vercel.app
NEXT_PUBLIC_SITE_URL=https://fhg-two.vercel.app

# ------------------------------------------------------------------------------
# 5. Media & Document Upload Storage (Vercel Blob)
# ------------------------------------------------------------------------------
# In production on Vercel, the filesystem is read-only.
# Connect Vercel Blob by creating a Blob store in the Vercel dashboard.
# Max file upload size: 25 MB (PDFs, images).
UPLOAD_PROVIDER=blob
BLOB_READ_WRITE_TOKEN=
