# Forest Hills Garden (FHG) - Environment Configuration

# ------------------------------------------------------------------------------
# 1. Admin Authentication
# ------------------------------------------------------------------------------
# Password used to log into the Admin CMS at /admin/login.
# Default if unset: admin1234
ADMIN_PASSWORD=admin1234

# Secret key used to sign and verify HMAC-SHA256 admin session cookies.
# Generate a random 32+ character string in production.
# Default if unset: fhg_secure_session_secret_key_2026_change_in_production
SESSION_SECRET=fhg_secure_session_secret_key_2026_change_in_production

# ------------------------------------------------------------------------------
# 2. Cloud Data Persistence (Recommended for Vercel Deployments)
# ------------------------------------------------------------------------------
# When running on Vercel, the local filesystem is ephemeral.
# Connect Upstash Redis or Vercel KV REST API to persist all CMS modifications
# permanently across redeployments and cold starts.
#
# If left unset, the system automatically falls back to:
# - data/admin-db.json (when running on a permanent filesystem / VPS / self-hosted)
# - in-memory cache with baseline data fallback
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ------------------------------------------------------------------------------
# 3. Email Notification for RFP / Inquiries
# ------------------------------------------------------------------------------
# Optional Resend API key for emailing new customer inquiries to the sales team.
# All submissions are ALWAYS recorded in the Admin Inbox (/admin/inquiries)
# regardless of whether an email service is configured.
RESEND_API_KEY=
CONTACT_EMAIL=info@foresthillsgarden.com

# ------------------------------------------------------------------------------
# 4. Public Site & Canonical URL
# ------------------------------------------------------------------------------
# Canonical domain used for OpenGraph cards, sitemaps, JSON-LD, and robots.txt.
# Default if unset: https://fhg-two.vercel.app
NEXT_PUBLIC_SITE_URL=https://fhg-two.vercel.app

# ------------------------------------------------------------------------------
# 5. Media & Document Upload Storage
# ------------------------------------------------------------------------------
# In production on Vercel, the filesystem is read-only.
# Connect Vercel Blob by creating a Blob store in the Vercel dashboard.
# UPLOAD_PROVIDER=blob | local (defaults to 'blob' if BLOB_READ_WRITE_TOKEN is set)
UPLOAD_PROVIDER=local
BLOB_READ_WRITE_TOKEN=
